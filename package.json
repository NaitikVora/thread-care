{
  "name": "thread-care",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Local-first, agentic daily care companion",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --import tsx apps/api/src/start.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "legacy": "node server.mjs",
    "test:browser": "node --import tsx tests/browser-fixture.ts",
    "test:postgres": "node --import tsx --test tests/postgres.integration.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@elevenlabs/react": "^1.15.2",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
