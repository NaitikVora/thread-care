# Optional; you can also enter a key under Settings in the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional stable encryption secret, minimum 32 characters.
# If blank, a mode-0600 secret file is created under DATA_DIR.
SESSION_SECRET=
# Local household data. Exclude this directory from source control.
DATA_DIR=.local-data
# Leave blank for embedded PGlite; set to use real PostgreSQL.
DATABASE_URL=
# Only needed for Docker Compose deployment. Choose a strong URL-safe password.
POSTGRES_PASSWORD=
PORT=4173
# Exact allowed frontend origin; use your HTTPS origin for a private hosted deployment.
PUBLIC_ORIGIN=
# All model, connection-test, and transcription attempts count. Resets midnight UTC.
MAX_AI_CALLS_PER_DAY=100

# ElevenLabs Agents: use Settings to create/connect a real private voice agent,
# or provide an already-configured agent here. Server keys never go to the UI.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
# Optional local household sign-in. Required with HTTPS before network hosting.
# Use two DIFFERENT passwords, each at least 16 characters.
THREAD_CAREGIVER_PASSWORD=
THREAD_PATIENT_PASSWORD=
# Keep loopback for local use. Network listening requires auth + HTTPS PUBLIC_ORIGIN.
HOST=127.0.0.1
